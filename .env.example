# ---------------------------------------------------------------------------
# Athena - AI Research Scientist
# Copy to .env and fill in. Every value is optional: with no key at all the
# system runs in offline mode, where model outputs are fixtures but literature
# search, RAG, PDF parsing, statistics and citations are all still real.
#
# Put your real key in .env (git-ignored), NEVER in this file.
# ---------------------------------------------------------------------------

# --- Model access --------------------------------------------------------
# An OpenAI API key. Without one, Athena runs entirely offline.
OPENAI_API_KEY=

# Force offline mode even when a key is present (useful for demos).
ATHENA_MOCK_MODE=false

# Model tiers. The fast model (gpt-4o-mini) handles planning, literature
# curation, gap analysis and citation formatting; the reasoning model (gpt-4o)
# handles synthesis, hypotheses, experiment design and the final write-up. The
# vision model reads figure images.
ATHENA_FAST_MODEL=gpt-4o-mini
ATHENA_REASONING_MODEL=gpt-4o
ATHENA_VISION_MODEL=gpt-4o-mini

# Audio transcription model (OpenAI Whisper).
ATHENA_TRANSCRIPTION_MODEL=whisper-1

# --- Budget guardrails -----------------------------------------------------
# Hard spending cap per run (USD). No new stage starts once it is reached.
ATHENA_MAX_RUN_USD=1.00
ATHENA_MAX_TURNS=12
ATHENA_MAX_PAPERS_PER_SOURCE=5
ATHENA_REQUEST_TIMEOUT_SECONDS=30
ATHENA_MAX_TOOL_RETRIES=3

# --- Human-in-the-loop -----------------------------------------------------
# When false, artefact saves proceed without asking. Leave true for the demo.
ATHENA_REQUIRE_HUMAN_APPROVAL=true

# --- Etiquette -----------------------------------------------------------
# Sent in the User-Agent to the public APIs. Crossref and OpenAlex give
# better rate limits to requests with a contact address.
ATHENA_CONTACT_EMAIL=you@example.com
